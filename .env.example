# Copy to .env and fill in. Never commit .env.

# Site names = the hostnames people open. Each is a separate CRM with its own data.
# Local:      crm-newral.localhost / crm-synappses.localhost (no DNS needed in Chrome)
# Production: crm.newral.in / crm.synappses.in (point both A records at the server)
NEWRAL_SITE=crm-newral.localhost
SYNAPPSES_SITE=crm-synappses.localhost

# Long random strings. ADMIN_PASSWORD is the "Administrator" login on both sites:
# sign in once, create real users for the sales team, then stop using it.
DB_ROOT_PASSWORD=
ADMIN_PASSWORD=

# Image built by ./build.sh
CUSTOM_IMAGE=newral-crm
CUSTOM_TAG=16
PULL_POLICY=never

# Port nginx listens on. In production behind compose.https.yml, leave as 8080.
HTTP_PORT=8080

# Production only: the email Let's Encrypt sends certificate notices to.
ACME_EMAIL=
