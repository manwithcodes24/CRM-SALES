# Copy to .env and fill in. Never commit .env.

# The CRM's hostname(s), space-separated. One site manages both Newral and Synappses.
# Local:      crm.localhost (no DNS needed in Chrome)
# Production: salescrm.newral.in (A record → the server)
SITES=crm.localhost

# Long random strings. ADMIN_PASSWORD is the "Administrator" login:
# sign in once, invite the sales team as users, then stop using it.
DB_ROOT_PASSWORD=
ADMIN_PASSWORD=

# Image built by ./build.sh
CUSTOM_IMAGE=newral-crm
CUSTOM_TAG=16
PULL_POLICY=never

# Port nginx listens on (localhost only). 8090 on the production server.
HTTP_PORT=8080

# compose.https.yml only: the email Let's Encrypt sends certificate notices to.
ACME_EMAIL=
